<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ExodusAI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
  <style>
    body {
      background: radial-gradient(circle at top left, #1a1a2e, #000000);
      font-family: 'Arial', sans-serif;
      color: #fff;
      overflow-x: hidden;
    }
    .fade-in {
      animation: fadeIn 1.2s ease-in-out forwards;
      opacity: 0;
    }
    @keyframes fadeIn {
      to { opacity: 1; transform: translateY(0); }
      from { opacity: 0; transform: translateY(20px); }
    }
    .gradient-text {
      background: linear-gradient(to right, #8b5cf6, #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen">

  <!-- HERO SECTION -->
  <header class="flex flex-col items-center justify-center text-center h-screen px-6">
    <h1 class="text-6xl md:text-7xl font-extrabold mb-6 gradient-text fade-in">
      ExodusAI
    </h1>
    <p class="text-gray-300 text-lg md:text-xl max-w-2xl fade-in">
      Asisten virtual modern yang fleksibel: ngobrol santai, minta rekomendasi, atau integrasi WhatsApp langsung.
    </p>
    <div class="mt-10 flex bg-gray-800 rounded-full p-2 w-full max-w-md fade-in">
      <input id="prompt-input" type="text" placeholder="Enter your prompt" 
             class="flex-grow bg-transparent px-4 text-white outline-none"/>
      <button id="generate-btn" 
              class="bg-gradient-to-r from-purple-500 to-pink-500 hover:opacity-90 transition text-white px-6 py-2 rounded-full">
        Generate AI
      </button>
    </div>
    <p class="text-gray-500 mt-4 fade-in">Tanpa limit</p>
  </header>

  <!-- FEATURE SECTION -->
  <section class="bg-black py-20 px-8 fade-in">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div class="order-2 md:order-1">
        <img src="https://demo.htmlcodex.com/2696/artificial-intelligence-html-template/img/hero-img.png"
             alt="AI Illustration"
             class="rounded-xl shadow-2xl hover:scale-105 transition-transform duration-500"/>
      </div>
      <div class="order-1 md:order-2 text-white">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 gradient-text">WhatsApp Integration</h2>
        <p class="text-gray-400 mb-6">Chatbot AI instan via WhatsApp. Cukup fleksibel untuk kebutuhan apapun.</p>
        <ul class="space-y-3 text-lg">
          <li class="flex items-center"><i class="fas fa-check-circle text-purple-500 mr-2"></i> Chatbot AI</li>
          <li class="flex items-center"><i class="fas fa-check-circle text-purple-500 mr-2"></i> Image Generator</li>
          <li class="flex items-center"><i class="fas fa-check-circle text-purple-500 mr-2"></i> Code AI</li>
        </ul>
        <button class="mt-8 bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-90 px-6 py-3 rounded-full font-bold transition">
          Chat ExodusAI
        </button>
      </div>
    </div>
  </section>

  <!-- PRIVACY SECTION -->
  <section class="bg-gradient-to-b from-black to-gray-900 py-20 px-8 fade-in">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 gradient-text">Privasi & Keamanan</h2>
    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8">
      <div class="bg-gray-800 p-6 rounded-xl shadow-lg hover:-translate-y-2 transition">
        <i class="fas fa-tasks text-purple-500 text-3xl mb-4"></i>
        <p class="text-gray-300">Chat dihapus otomatis dalam 1 detik, admin tidak bisa membaca percakapan Anda.</p>
      </div>
      <div class="bg-gray-800 p-6 rounded-xl shadow-lg hover:-translate-y-2 transition">
        <i class="fas fa-shield-alt text-purple-500 text-3xl mb-4"></i>
        <p class="text-gray-300">Tidak ada data yang tersimpan di database. Hanya Anda & AI yang tahu isinya.</p>
      </div>
      <div class="bg-gray-800 p-6 rounded-xl shadow-lg hover:-translate-y-2 transition">
        <i class="fas fa-clipboard-list text-purple-500 text-3xl mb-4"></i>
        <p class="text-gray-300">Tidak ada percakapan yang tercatat di log server.</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-black py-8 text-center text-gray-500 text-sm">
    <p>Copyright © ExodusAI 2024. All Rights Reserved</p>
  </footer>

  <script>
    document.getElementById('generate-btn').addEventListener('click', function() {
      const prompt = document.getElementById('prompt-input').value;
      if(prompt) {
        const encodedPrompt = encodeURIComponent(prompt);
        const whatsappUrl = "https://wa.me/6285150984232?text=" + encodedPrompt;
        window.location.href = whatsappUrl;
      } else {
        alert("Please enter a prompt.");
      }
    });
  </script>
</body>
</html>
