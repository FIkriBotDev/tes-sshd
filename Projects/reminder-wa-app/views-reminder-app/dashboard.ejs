<%- include('partials/header') %>
<title>Reminder App - Dashboard</title>
<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-semibold">Dashboard</h1>
  <div>
    <a href="/reminder/create" class="bg-green-600 text-white px-3 py-2 rounded">Buat Reminder</a>
  </div>
</div>

<div class="bg-white rounded shadow p-4 mb-4">
  <h3 class="font-semibold mb-2">Informasi</h3>
  <div class="text-sm text-gray-600">Timezone: <%= tz %></div>
  <div class="text-sm text-gray-600 mt-1">Nomor terdaftar: <%= user.phone %></div>
</div>

<div class="grid grid-cols-1 gap-4">
  <% if (reminders.length === 0) { %>
    <div class="bg-white p-6 rounded shadow text-center text-gray-600">Belum ada reminder. Buat yang pertama!</div>
  <% } %>

  <% reminders.forEach(r => { %>
    <div class="bg-white p-4 rounded shadow">
      <div class="flex justify-between">
        <div>
          <div class="text-lg font-semibold"><%= r.title %> <span class="text-sm text-gray-500">(<%= r.priority %>)</span></div>
          <div class="text-sm text-gray-600">Tanggal: <%= r.date %> · Waktu: <%= r.time %> · Repeat: <%= r.repeat %></div>
          <div class="text-sm text-gray-600 mt-1">Offsets: <%= (r.offsets || []).join(', ') %> menit sebelum</div>
          <div class="text-sm text-gray-600 mt-1">Lokasi: <%= r.location || '-' %></div>
          <div class="text-sm text-gray-600 mt-1">Catatan: <%= r.description || '-' %></div>
        </div>
        <div class="flex flex-col gap-2">
          <a href="/reminder/edit/<%= r.id %>" class="text-sm text-blue-600">Edit</a>
          <form method="post" action="/reminder/delete/<%= r.id %>">
            <button class="text-sm text-red-600">Hapus</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
