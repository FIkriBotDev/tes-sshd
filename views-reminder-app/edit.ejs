<%- include('partials/header') %>
<title>Reminder App - Edit</title>
<div class="bg-white p-6 rounded shadow">
  <h2 class="text-2xl font-semibold mb-4">Edit Reminder</h2>

  <% if (error) { %>
    <div class="bg-red-100 text-red-700 p-2 rounded mb-4"><%= error %></div>
  <% } %>

  <form method="post" class="space-y-3">
    <div>
      <label class="block text-sm">Judul / Kegiatan *</label>
      <input name="title" value="<%= reminder.title %>" class="w-full border p-2 rounded" />
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm">Tanggal (YYYY-MM-DD) *</label>
        <input name="date" type="date" value="<%= reminder.date %>" class="w-full border p-2 rounded" />
      </div>
      <div>
        <label class="block text-sm">Jam (HH:MM) *</label>
        <input name="time" type="time" value="<%= reminder.time %>" class="w-full border p-2 rounded" />
      </div>
    </div>

    <div>
      <label class="block text-sm">Notifikasi / Reminder (coma separated dalam menit). Contoh: 10,5,1</label>
      <input name="offsets" value="<%= (reminder.offsets || []).filter(o=>o!==0).join(',') %>" class="w-full border p-2 rounded" placeholder="10,5,1" />
      <div class="text-xs text-gray-500 mt-1">0 menit (tepat waktu) selalu otomatis termasuk.</div>
    </div>

    <div>
      <label class="block text-sm">Deskripsi / Catatan</label>
      <input name="description" value="<%= reminder.description %>" class="w-full border p-2 rounded" />
    </div>

    <div class="grid grid-cols-3 gap-3">
      <div>
        <label class="block text-sm">Lokasi</label>
        <input name="location" value="<%= reminder.location %>" class="w-full border p-2 rounded" />
      </div>
      <div>
        <label class="block text-sm">Kategori/Tag</label>
        <input name="category" value="<%= reminder.category %>" class="w-full border p-2 rounded" />
      </div>
      <div>
        <label class="block text-sm">Prioritas</label>
        <select name="priority" class="w-full border p-2 rounded">
          <option value="rendah" <%= reminder.priority==='rendah' ? 'selected' : '' %>>Rendah</option>
          <option value="sedang" <%= reminder.priority==='sedang' ? 'selected' : '' %>>Sedang</option>
          <option value="tinggi" <%= reminder.priority==='tinggi' ? 'selected' : '' %>>Tinggi</option>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm">Repeat</label>
      <select name="repeat" class="w-full border p-2 rounded">
        <option value="none" <%= reminder.repeat==='none' ? 'selected' : '' %>>None</option>
        <option value="daily" <%= reminder.repeat==='daily' ? 'selected' : '' %>>Harian</option>
        <option value="weekly" <%= reminder.repeat==='weekly' ? 'selected' : '' %>>Mingguan</option>
        <option value="monthly" <%= reminder.repeat==='monthly' ? 'selected' : '' %>>Bulanan</option>
        <option value="custom" <%= reminder.repeat==='custom' ? 'selected' : '' %>>Custom</option>
      </select>
    </div>

    <div>
      <label class="block text-sm">Custom Dates (jika pilih custom). Pisahkan dengan koma, format YYYY-MM-DD</label>
      <input name="customDates" value="<%= (reminder.customDates || []).join(',') %>" class="w-full border p-2 rounded" placeholder="2025-09-09,2025-09-11" />
    </div>

    <div class="flex justify-end">
      <button class="bg-blue-600 text-white px-4 py-2 rounded">Simpan Perubahan</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
